# Google Analytics 4 — Measurement ID (format: G-XXXXXXXXXX)
# Get it from: https://analytics.google.com → Admin → Data Streams
NEXT_PUBLIC_GA_ID=

# Google Search Console — verification meta tag value
# Get it from: https://search.google.com/search-console → Add Property → HTML tag method
NEXT_PUBLIC_GSC_VERIFICATION=

# SEO Factory — read-only articles API key (runtime only, never commit the value)
SEO_FACTORY_API_KEY=
